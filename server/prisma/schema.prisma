generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  productName String
  productCode String   @unique
  releaseDate DateTime
  description String
  price       Decimal
  starRating  Float
  imageUrl    String
  tags        String[]
}